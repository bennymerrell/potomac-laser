         "editor": "<p class=\"pills\"><span class=\"pill\">Kapton (polyimide)</span><span class=\"pill\">PET (Mylar)</span><span class=\"pill\">Ultem</span><span class=\"pill\">Nylon</span><span class=\"pill\">PEEK</span><span class=\"pill\">Silicone</span><span class=\"pill\">PMMA</span><span class=\"pill\">PTFE</span></p>",
