     {
      "id": "cd00d8e",
      "elType": "widget",
      "widgetType": "html",
      "settings": {
       "html": "<style>\n.gf-rapid-wrap{max-width:1260px;\n  margin:0 auto;\n  display:grid;\n  grid-template-columns:minmax(0,1.1fr) minmax(360px,.72fr);\n  gap:42px;\n  align-items:start;}\n.gf-rapid-kicker{display:flex;\n  align-items:center;\n  gap:14px;\n  color:#F5821F;\n  font-size:11px;\n  font-weight:800;\n  letter-spacing:.18em;\n  text-transform:uppercase;\n  margin-bottom:14px;}\n.gf-rapid-kicker span{width:32px;height:2px;background:#F5821F;display:inline-flex}\n.gf-rapid-left h2{margin:0 0 18px;\n  color:#1D3557;\n  font-family:'Inter',system-ui,sans-serif;\n  font-size:clamp(1.9rem,3vw,2.55rem);\n  line-height:1.12;\n  letter-spacing:-.03em;\n  font-weight:800;}\n.gf-rapid-copy{max-width:680px;color:#5F6878;font-size:15px;line-height:1.7;margin-bottom:36px}\n.gf-rapid-copy p{margin:0 0 10px}\n.gf-rapid-secure{font-size:13px;color:#737C8D}\n.gf-rapid-secure strong{color:#F5821F;font-weight:800}\n.gf-rapid-steps{display:grid;gap:14px;max-width:680px}\n.gf-rapid-step{position:relative;\n  background:#fff;\n  border:1px solid #E1E6EE;\n  border-radius:12px;\n  box-shadow:0 1px 2px rgba(15,42,68,.03);\n  padding:30px 22px 22px;\n  min-height:104px;}\n.gf-rapid-num{position:absolute;top:-16px;left:22px;width:38px;height:38px;border-radius:999px;\n  background:#F5821F;color:#fff;display:flex;align-items:center;justify-content:center;\n  font-weight:800;font-size:16px;box-shadow:0 10px 20px rgba(245,130,31,.2)}\n.gf-rapid-label{color:#F5821F;font-size:10px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin-bottom:6px}\n.gf-rapid-step h3{margin:0 0 6px;color:#1D3557;font-size:15px;line-height:1.3;font-weight:800}\n.gf-rapid-step p{margin:0;color:#5F6878;font-size:13px;line-height:1.55}\n.gf-rapid-card{background:#fff;border:1px solid #E1E6EE;border-radius:18px;\n  box-shadow:0 18px 46px rgba(15,42,68,.08);padding:28px}\n.gf-rapid-progress{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;margin-bottom:28px}\n.gf-rapid-progress-item{display:flex;align-items:center;gap:10px;white-space:nowrap;color:#6B7280}\n.gf-rapid-progress-item span{width:30px;height:30px;border-radius:999px;display:flex;align-items:center;justify-content:center;\n  background:#F1F4F8;border:2px solid #E5E9EF;color:#6B7280;font-weight:800;font-size:13px}\n.gf-rapid-progress-item.active span{background:#F5821F;border-color:#FFE1CA;color:#fff;box-shadow:0 0 0 5px #FFF2E8}\n.gf-rapid-progress-item strong{color:#1D3557;font-size:13px;font-weight:800}\n.gf-rapid-progress-item:not(.active) strong{color:#6B7280}\n.gf-rapid-progress-line{height:3px;background:#E6E9EF;border-radius:999px;position:relative}\n.gf-rapid-progress-line::before{content:'';position:absolute;left:0;top:0;bottom:0;width:50%;background:#F5821F;border-radius:999px}\n.gf-rapid-form-title{color:#1D3557;font-size:17px;line-height:1.35;margin:0 0 22px;font-weight:800}\n.gf-rapid-card form{display:grid;gap:18px}\n.gf-rapid-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n.gf-rapid-card label{display:grid;gap:8px}\n.gf-rapid-card label span{color:#6F7787;text-transform:uppercase;letter-spacing:.16em;font-size:10px;font-weight:800}\n.gf-rapid-card label span em{color:#F5821F;font-style:normal}\n.gf-rapid-card input,.gf-rapid-card textarea{width:100%;box-sizing:border-box;border:1px solid #DDE4EC;border-radius:12px;background:#fff;\n  padding:13px 16px;color:#1D3557;font-size:14px;font-family:'Inter',system-ui,sans-serif;\n  line-height:1.45;outline:none;transition:border-color .18s,box-shadow .18s}\n.gf-rapid-card input::placeholder,.gf-rapid-card textarea::placeholder{color:#A1A9B7}\n.gf-rapid-card input:focus,.gf-rapid-card textarea:focus{border-color:#F5821F;box-shadow:0 0 0 3px rgba(245,130,31,.12)}\n.gf-rapid-card textarea{min-height:96px;resize:vertical}\n.gf-rapid-upload{border:1px solid #DDE4EC;border-radius:12px;background:#FBFCFE;padding:12px 14px}\n.gf-rapid-upload input{border:0;padding:0;border-radius:0;background:transparent;font-size:12px;color:#697386}\n.gf-rapid-upload input::file-selector-button{border:0;background:#FFF2E8;color:#F5821F;border-radius:999px;padding:8px 14px;margin-right:10px;\n  font-size:12px;font-weight:800;cursor:pointer}\n.gf-rapid-card small{color:#737C8D;font-size:12px;line-height:1.5}\n.gf-rapid-actions{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:4px}\n.gf-rapid-actions p{margin:0;color:#8A93A3;font-size:12px}\n.gf-rapid-actions button{border:0;background:#F5821F;color:#fff;border-radius:999px;padding:14px 26px;min-width:170px;\n  font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;\n  box-shadow:0 10px 28px rgba(245,130,31,.22)}\n.gf-rapid-actions button:hover{background:#D96E10}\n.gf-rapid-wrap{grid-template-columns:1fr}\n.gf-rapid-card{max-width:680px}\n.gf-rapid-quote{padding:52px 18px}\n.gf-rapid-grid{grid-template-columns:1fr}\n.gf-rapid-card{padding:22px}\n.gf-rapid-progress{grid-template-columns:1fr;gap:10px}\n.gf-rapid-progress-line{display:none}\n.gf-rapid-actions{flex-direction:column;align-items:stretch}\n.gf-rapid-actions button{width:100%;min-width:0}\n.gf-rapid-left h2{font-size:2rem}\n@media(max-width:1100px){.gf-rapid-wrap{grid-template-columns:1fr}.gf-rapid-card{max-width:680px}}\n@media(max-width:640px){.gf-rapid-quote{padding:52px 18px}.gf-rapid-grid{grid-template-columns:1fr}.gf-rapid-card{padding:22px}.gf-rapid-progress{grid-template-columns:1fr;gap:10px}.gf-rapid-progress-line{display:none}.gf-rapid-actions{flex-direction:column;align-items:stretch}.gf-rapid-actions button{width:100%;min-width:0}.gf-rapid-left h2{font-size:2rem}}\n.gf-rapid-left h2{font-family:\"Inter\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif !important;\n  font-weight:800 !important;\n  letter-spacing:-0.03em;\n  color:#22395D;}\n.gf-rapid-card select:focus{border-color:#F5821F;box-shadow:0 0 0 3px rgba(245,130,31,.12)}\n.gf-rapid-note{padding:12px 14px;background:#FFF7F0;border:1px solid #FBE0C7;border-radius:12px;\n  font-size:12px;line-height:1.55;color:#5F6878}\n.gf-rapid-note strong{color:#D96E10;font-weight:800}\n.gf-rapid-card form[hidden]{display:none !important}\n.pl-confirm{padding:26px 4px;text-align:center}\n.pl-confirm-badge{width:46px;height:46px;border-radius:50%;background:#EAF7EE;display:flex;align-items:center;justify-content:center;margin:0 auto 14px}\n.pl-confirm-badge svg{width:24px;height:24px;fill:none;stroke:#1E9E52;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}\n.pl-confirm h3{margin:0 0 8px;font-size:19px;font-weight:800;color:#15253D}\n.pl-confirm p{margin:0;font-size:14px;line-height:1.55;color:#5F6878}\n.pl-err{margin:0 0 14px;padding:10px 12px;border:1px solid #F0C2C2;background:#FDF3F3;color:#9B2C2C;border-radius:8px;font-size:13px;line-height:1.45}\n.pl-quote-busy{opacity:.6;pointer-events:none}\n</style>\n<div class=\"gf-rapid-wrap\">\n<div class=\"gf-rapid-left\">\n      <div class=\"gf-rapid-kicker\"><span></span>Rapid Response Quote</div>\n      <h2>Ready to move forward?</h2>\n      <div class=\"gf-rapid-copy\">\n        <p>Upload your drawing or request a quote — our engineering team will review your design and respond within 24 hours.</p>\n        <p>No redesign required to start — we'll help optimise your part.</p>\n        <p class=\"gf-rapid-secure\"><strong>♢</strong> Uploads stay confidential. We can sign your NDA on request before you share files.</p>\n      </div>\n      <div class=\"gf-rapid-steps\">\n        <div class=\"gf-rapid-step\">\n          <div class=\"gf-rapid-num\">1</div>\n          <div><div class=\"gf-rapid-label\">Now</div><h3>You submit your request</h3><p>Name, email, description, drawing. No commitment.</p></div>\n        </div>\n        <div class=\"gf-rapid-step\">\n          <div class=\"gf-rapid-num\">2</div>\n          <div><div class=\"gf-rapid-label\">Within hours</div><h3>Engineer reviews your part</h3><p>DFM check on geometry, tolerances, material fit.</p></div>\n        </div>\n        <div class=\"gf-rapid-step\">\n          <div class=\"gf-rapid-num\">3</div>\n          <div><div class=\"gf-rapid-label\">Within 24 hours</div><h3>Quote &amp; process path confirmed</h3><p>Feasibility, recommended process, next steps.</p></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"gf-rapid-card\">\n      <div class=\"gf-rapid-progress\">\n        <div class=\"gf-rapid-progress-item active\"><span>1</span><strong>Your part</strong></div>\n        <div class=\"gf-rapid-progress-line\"></div>\n        <div class=\"gf-rapid-progress-item\"><span>2</span><strong>Project details</strong></div>\n      </div>\n      <h3 class=\"gf-rapid-form-title\">Step 1 — Tell us about your part</h3>\n      <form id=\"pl-quote-form\" novalidate>\n        <div class=\"gf-rapid-grid\">\n          <label><span>Your name <em>*</em></span><input id=\"r-name\" name=\"name\" type=\"text\" autocomplete=\"name\" placeholder=\"Dr. Jane Smith\" required></label>\n          <label><span>Organisation</span><input id=\"r-org\" name=\"org\" type=\"text\" autocomplete=\"organization\" placeholder=\"University / Company\"></label>\n        </div>\n        <label><span>Email <em>*</em></span><input id=\"r-email\" name=\"email\" type=\"email\" autocomplete=\"email\" placeholder=\"j.smith@example.com\" required></label>\n        <label><span>Part description and requirements <em>*</em></span><textarea id=\"r-desc\" name=\"description\" rows=\"4\" required placeholder=\"e.g. Titanium implant, 4 machined faces, ±8 µm on mating surfaces, 50 parts, first-article report required\"></textarea></label>\n        <label>\n          <span>Upload drawing / CAD</span>\n          <div class=\"gf-rapid-upload\"><input id=\"r-file\" name=\"file\" type=\"file\" accept=\".step,.stp,.stl,.iges,.igs,.pdf,.dxf,.dwg,.zip\"></div>\n          <small>STEP, STL, IGES, PDF, DXF, DWG, or ZIP up to 25 MB</small>\n        </label>\n        <div class=\"gf-rapid-actions\"><p>No commitment · 24h response</p><button type=\"button\" type=\"submit\" id=\"r-submit\">Continue →</button></div>\n      </form></div>\n</div>\n<script>\n\n(function(){\n  var PORTAL='143181153', FORM='9dba7d36-e36b-4a10-9411-9dc073dab7a0', FORM_ID='rapid_response_quote';\n  var UPLOAD='/wp-json/cnc-quote/v1/upload';\n  var root=document.getElementById('pl-quote-form'); if(!root||root.dataset.plWired) return; root.dataset.plWired='1';\n  var card=root.closest('.gf-rapid-card');\n\n  function utm(){\n    var out={}, qs=new URLSearchParams(location.search);\n    ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid'].forEach(function(k){ var v=qs.get(k); if(v) out[k]=v; });\n    try{\n      if(Object.keys(out).length){ localStorage.setItem('pl_utm_last',JSON.stringify(out)); if(!localStorage.getItem('pl_utm_first')) localStorage.setItem('pl_utm_first',JSON.stringify(out)); }\n      else { out=JSON.parse(localStorage.getItem('pl_utm_last')||'null')||JSON.parse(localStorage.getItem('pl_utm_first')||'null')||{}; }\n    }catch(e){}\n    return out;\n  }\n  function hutk(){ var m=document.cookie.match(/hubspotutk=([^;]+)/); return m?m[1]:''; }\n  function track(ev,data){\n    var p={event:ev,form_id:FORM_ID,page_path:location.pathname};\n    var u=utm(); for(var k in u) p[k]=u[k];\n    if(data) for(var k2 in data) p[k2]=data[k2];\n    try{ (window.dataLayer=window.dataLayer||[]).push(p); }catch(e){}\n    try{ if(window.gtag) window.gtag('event',ev,p); }catch(e){}\n  }\n  function err(msg){\n    var prev=card&&card.querySelector('.pl-err'); if(prev) prev.remove();\n    var d=document.createElement('div'); d.className='pl-err'; d.textContent='⚠ '+msg;\n    root.parentNode.insertBefore(d,root);\n    try{ d.scrollIntoView({behavior:'smooth',block:'center'}); }catch(e){}\n  }\n  function done(msg){\n    if(!card) return;\n    card.innerHTML='<div class=\"pl-confirm\"><div class=\"pl-confirm-badge\">'\n      +'<svg viewBox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"/></svg></div>'\n      +'<h3>Request received — thank you</h3><p>'+msg+'</p></div>';\n    try{ card.scrollIntoView({behavior:'smooth',block:'center'}); }catch(e){}\n  }\n  var started=false;\n  root.addEventListener('input',function(){ if(!started){ started=true; track('lead_form_start'); } },{once:false});\n  ['r-name','r-org','r-email','r-desc'].forEach(function(id){\n    var el=document.getElementById(id); if(!el) return;\n    el.addEventListener('blur',function(){\n      if(!el.value.trim()) return;\n      // PII never carries a value into analytics\n      var pii=(id==='r-name'||id==='r-email'||id==='r-desc');\n      track('lead_form_field', pii?{field_name:id.slice(2),field_filled:1}:{field_name:id.slice(2),field_value:el.value.trim().slice(0,60)});\n    });\n  });\n\n  async function upload(input){\n    if(!input||!input.files||!input.files[0]) return '';\n    var fd=new FormData(); fd.append('file',input.files[0]);\n    try{\n      var r=await fetch(UPLOAD,{method:'POST',body:fd}); var j=await r.json();\n      if(r.ok&&j&&j.url) return j.url;\n      err('That file could not be uploaded ('+((j&&j.error)||'unknown')+'). Send the request without it, or try a smaller file.');\n      return null;\n    }catch(e){ console.error(e); err('That file could not be uploaded. Send the request without it, or try again.'); return null; }\n  }\n\n  root.addEventListener('submit',async function(ev){\n    ev.preventDefault();\n    var prev=card&&card.querySelector('.pl-err'); if(prev) prev.remove();\n    var name=(document.getElementById('r-name').value||'').trim();\n    var org=(document.getElementById('r-org').value||'').trim();\n    var email=(document.getElementById('r-email').value||'').trim();\n    var desc=(document.getElementById('r-desc').value||'').trim();\n    if(!name||!email||!desc){ err('Please add your name, email, and a part description.'); return; }\n    if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)){ err('That email address does not look right — please check it.'); return; }\n    root.classList.add('pl-quote-busy');\n    var fileUrl=await upload(document.getElementById('r-file'));\n    if(fileUrl===null){ root.classList.remove('pl-quote-busy'); return; }\n    var parts=name.split(/\\s+/);\n    var fields={\n      email:email,\n      firstname:parts.shift(),\n      lastname:parts.join(' '),\n      company:org,\n      potomac_project_name:'Rapid Response Quote — '+document.title,\n      potomac_project_description:desc,\n      potomac_file_submission:fileUrl||'',\n      hs_lead_status:'NEW'\n    };\n    var u=utm(); for(var k in u) fields[k]=u[k];\n    var props=Object.keys(fields).filter(function(k){ return fields[k]!=null&&fields[k]!==''; })\n      .map(function(k){ return {objectTypeId:'0-1',name:k,value:String(fields[k])}; });\n    track('lead_form_submit',{fields_completed:props.length});\n    try{\n      var r=await fetch('https://api.hsforms.com/submissions/v3/integration/submit/'+PORTAL+'/'+FORM,{\n        method:'POST',headers:{'Content-Type':'application/json'},\n        body:JSON.stringify({fields:props,context:{pageName:document.title,pageUri:location.href,hutk:hutk()||undefined}})\n      });\n      var j=await r.json().catch(function(){ return null; });\n      if(r.ok){ track('lead_form_submit_success'); done('Our engineers will review your request and respond within 24 hours.'); return; }\n      console.error('HubSpot submit failed',r.status,j);\n      track('lead_form_submit_error',{error:'http_'+r.status});\n      err('We could not send that just now. Please try again, or email inq@goodfellow.com.');\n    }catch(e){\n      console.error(e); track('lead_form_submit_error',{error:'network'});\n      err('We could not send that just now. Please check your connection, or email inq@goodfellow.com.');\n    }\n    root.classList.remove('pl-quote-busy');\n  });\n\n  // The design's action button is type=\"button\", so it never raises a submit event.\n  // Bind it explicitly and route through the same handler; Enter-to-submit still works\n  // because the submit listener above stays in place.\n  Array.prototype.forEach.call(root.querySelectorAll('button'), function(b){\n    if(b.dataset.plBound) return; b.dataset.plBound='1';\n    b.addEventListener('click', function(ev){\n      ev.preventDefault();\n      root.dispatchEvent(new Event('submit', {cancelable:true, bubbles:false}));\n    });\n  });\n})();\n\n</script>"
      },
      "elements": []
     }
    ],
    "isInner": false
   }
