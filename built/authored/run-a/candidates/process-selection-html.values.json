 "embed_1": "<style>.pl-svc-procsel li{padding:0}.pl-svc-procsel{scroll-behavior: smooth; scroll-padding-top: 120px;}\n.pl-svc-procsel{font-family: Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden;}\n@keyframes fuUp { \n  0% { opacity: 0; transform: translateY(18px); }\n  100% { opacity: 1; transform: none; }\n}\n.pl-svc-procsel.process-shot-shell{background: rgb(255, 255, 255);}\n.pl-svc-procsel .process-shot-eyebrow{display: inline-flex; align-items: center; justify-content: center; border-radius: 9999px; padding: 8px 14px; background: rgb(238, 242, 247); color: rgb(90, 102, 119); font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase;}\n.pl-svc-procsel .process-shot-panel{position: relative; overflow: hidden; border-radius: 20px; background: linear-gradient(135deg, rgb(27, 36, 52) 0%, rgb(34, 50, 72) 52%, rgb(29, 44, 66) 100%); box-shadow: rgba(15, 42, 68, 0.18) 0px 22px 58px; border: 1px solid rgba(255, 255, 255, 0.06);}\n.pl-svc-procsel .process-shot-panel::before{content: \"\"; position: absolute; inset: 0px; background-image: linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px); background-size: 16px 16px; pointer-events: none;}\n.pl-svc-procsel .process-shot-panel::after{content: \"\"; position: absolute; inset: 0px; background: radial-gradient(circle at 18% 8%, rgba(245, 130, 31, 0.08) 0%, transparent 22%), radial-gradient(circle at 84% 18%, rgba(99, 126, 164, 0.16) 0%, transparent 24%); pointer-events: none;}\n.pl-svc-procsel .process-shot-inner{position: relative; z-index: 1; padding: 20px;}\n@media (min-width: 768px){.pl-svc-procsel .process-shot-inner{padding: 24px;}}\n@media (min-width: 1280px){.pl-svc-procsel .process-shot-inner{padding: 28px;}}\n.pl-svc-procsel .process-shot-intro{font-size: 15px; line-height: 1.7; color: rgba(255, 255, 255, 0.88); margin: 0px 0px 18px;}\n.pl-svc-procsel .process-shot-grid{display: grid; gap: 14px;}\n@media (min-width: 1024px){.pl-svc-procsel .process-shot-grid{grid-template-columns: repeat(3, minmax(0px, 1fr));}}\n.pl-svc-procsel .process-shot-card{border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.05); padding: 18px;}\n.pl-svc-procsel .process-shot-kicker{font-size: 11px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; margin: 0px 0px 8px;}\n.pl-svc-procsel .process-shot-kicker.cnc{color: rgb(107, 208, 227);}\n.pl-svc-procsel .process-shot-kicker.alt{color: rgba(255, 255, 255, 0.74);}\n.pl-svc-procsel .process-shot-card h3{margin: 0px 0px 8px; font-size: 1.15rem; line-height: 1.25; font-weight: 800; color: rgb(255, 255, 255);}\n.pl-svc-procsel .process-shot-subhead{font-size: 14px; font-weight: 700; color: rgb(255, 255, 255); margin: 0px 0px 10px;}\n.pl-svc-procsel .process-shot-list{list-style: none; margin: 0px 0px 14px; padding: 0px; display: flex; flex-direction: column; gap: 10px;}\n.pl-svc-procsel .process-shot-list li{position: relative; padding-left: 14px; font-size: 14px; line-height: 1.55; color: rgba(255, 255, 255, 0.92);}\n.pl-svc-procsel .process-shot-list li::before{content: \"\"; position: absolute; left: 0px; top: 8px; width: 5px; height: 5px; border-radius: 9999px; background: rgb(245, 130, 31);}\n.pl-svc-procsel .process-shot-spec{font-size: 14px; line-height: 1.55; color: rgba(255, 255, 255, 0.9); margin: 0px 0px 12px;}\n.pl-svc-procsel .process-shot-spec strong{color: rgb(245, 130, 31); font-weight: 800;}\n.pl-svc-procsel .process-shot-link{display: inline-flex; align-items: center; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(245, 130, 31); text-decoration: none;}\n.pl-svc-procsel .process-shot-footer{margin-top: 14px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.04); padding: 18px; display: flex; flex-direction: column; gap: 16px;}\n@media (min-width: 900px){.pl-svc-procsel .process-shot-footer{flex-direction: row; align-items: center; justify-content: space-between;}}\n.pl-svc-procsel .process-shot-footer-title{margin: 0px 0px 8px; font-size: 1rem; line-height: 1.4; font-weight: 800; color: rgb(255, 255, 255);}\n.pl-svc-procsel .process-shot-footer-copy{font-size: 12px; line-height: 1.7; color: rgba(255, 255, 255, 0.74); margin: 0px;}\n.pl-svc-procsel .process-shot-footer-copy + .process-shot-footer-copy{margin-top: 4px;}\n.pl-svc-procsel .process-shot-footer-note{margin-top: 8px;}\n.pl-svc-procsel .process-shot-cta-row{display: flex; flex-wrap: wrap; gap: 12px;}\n.pl-svc-procsel .process-shot-cta-primary{display: inline-flex; align-items: center; justify-content: center; border: 0px; border-radius: 9999px; background: rgb(245, 130, 31); color: rgb(255, 255, 255); padding: 14px 26px; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; text-decoration: none; box-shadow: rgba(245, 130, 31, 0.22) 0px 10px 24px;}\n.pl-svc-procsel .process-shot-cta-secondary{display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(255, 255, 255, 0.22); border-radius: 9999px; background: transparent; color: rgb(255, 255, 255); padding: 14px 26px; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; text-decoration: none;}\n@keyframes pulse { \n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.6; transform: scale(1.3); }\n}\n.pl-svc-procsel button, .pl-svc-procsel a[href]{-webkit-tap-highlight-color: rgba(245, 130, 31, 0.18);}\n.pl-svc-procsel{font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important; color: rgb(34, 57, 93);}\n.pl-svc-procsel h2, .pl-svc-procsel h3{letter-spacing: -0.03em; color: rgb(34, 57, 93); font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important; font-weight: 800 !important;}\n.pl-svc-procsel p, .pl-svc-procsel li, .pl-svc-procsel button, .pl-svc-procsel a{font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important;}\n.pl-svc-procsel, .pl-svc-procsel *, .pl-svc-procsel::before, .pl-svc-procsel ::before, .pl-svc-procsel::after, .pl-svc-procsel ::after{--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;}\n.pl-svc-procsel::backdrop, .pl-svc-procsel ::backdrop{--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;}\n.pl-svc-procsel, .pl-svc-procsel *, .pl-svc-procsel::after, .pl-svc-procsel ::after, .pl-svc-procsel::before, .pl-svc-procsel ::before{box-sizing: border-box; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235);}\n.pl-svc-procsel::after, .pl-svc-procsel ::after, .pl-svc-procsel::before, .pl-svc-procsel ::before{--tw-content: '';}\n.pl-svc-procsel{line-height: 1.5; text-size-adjust: 100%; tab-size: 4; font-family: Inter, system-ui, sans-serif; font-feature-settings: normal; font-variation-settings: normal; -webkit-tap-highlight-color: transparent;}\n.pl-svc-procsel{margin: 0px;}\n.pl-svc-procsel h2, .pl-svc-procsel h3{font-size: inherit; font-weight: inherit;}\n.pl-svc-procsel a{color: inherit; text-decoration: inherit;}\n.pl-svc-procsel strong{font-weight: bolder;}\n.pl-svc-procsel button{font-family: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-size: 100%; font-weight: inherit; line-height: inherit; letter-spacing: inherit; color: inherit; margin: 0px; padding: 0px;}\n.pl-svc-procsel button{text-transform: none;}\n.pl-svc-procsel button{appearance: button; background-color: transparent; background-image: none;}\n.pl-svc-procsel::-webkit-inner-spin-button, .pl-svc-procsel ::-webkit-inner-spin-button, .pl-svc-procsel::-webkit-outer-spin-button, .pl-svc-procsel ::-webkit-outer-spin-button{height: auto;}\n.pl-svc-procsel::-webkit-search-decoration, .pl-svc-procsel ::-webkit-search-decoration{appearance: none;}\n.pl-svc-procsel::-webkit-file-upload-button, .pl-svc-procsel ::-webkit-file-upload-button{appearance: button; font: inherit;}\n.pl-svc-procsel h2, .pl-svc-procsel h3, .pl-svc-procsel p{margin: 0px;}\n.pl-svc-procsel ul{list-style: none; margin: 0px; padding: 0px;}\n.pl-svc-procsel button{cursor: pointer;}\n.pl-svc-procsel .mx-auto{margin-left: auto; margin-right: auto;}\n.pl-svc-procsel .mb-10{margin-bottom: 2.5rem;}\n.pl-svc-procsel .mb-3{margin-bottom: 0.75rem;}\n.pl-svc-procsel .mb-4{margin-bottom: 1rem;}\n.pl-svc-procsel .max-w-page{max-width: 1260px;}\n.pl-svc-procsel .max-w-\\[650px\\]{max-width: 650px;}\n.pl-svc-procsel .max-w-\\[760px\\]{max-width: 760px;}\n.pl-svc-procsel.px-6{padding-left: 1.5rem; padding-right: 1.5rem;}\n.pl-svc-procsel.py-16{padding-top: 4rem; padding-bottom: 4rem;}\n.pl-svc-procsel .text-center{text-align: center;}\n.pl-svc-procsel .font-display{font-family: Inter, system-ui, sans-serif;}\n.pl-svc-procsel .text-\\[15px\\]{font-size: 15px;}\n.pl-svc-procsel .font-extrabold{font-weight: 800;}\n.pl-svc-procsel .leading-relaxed{line-height: 1.625;}\n.pl-svc-procsel .leading-tight{line-height: 1.25;}\n.pl-svc-procsel .tracking-tight{letter-spacing: -0.025em;}\n.pl-svc-procsel .text-gray-500{--tw-text-opacity: 1; color: rgb(107 114 128 / var(--tw-text-opacity, 1));}\n.pl-svc-procsel .text-navy-mid{--tw-text-opacity: 1; color: rgb(29 53 87 / var(--tw-text-opacity, 1));}</style><section aria-labelledby=\"process-selection\" class=\"pl-svc-procsel process-shot-shell py-16 px-6\">\n<div class=\"max-w-page mx-auto\">\n<div class=\"text-center mb-10\">\n<div class=\"process-shot-eyebrow mb-4\">Process Selection</div>\n<h2 class=\"font-display font-extrabold text-navy-mid leading-tight tracking-tight mb-3\" id=\"process-selection\" style=\"font-size:clamp(1.9rem,3vw,2.8rem)\">CNC vs. Laser vs. Conventional Machining</h2>\n<p class=\"text-[15px] text-gray-500 leading-relaxed max-w-[760px] mx-auto\">Use this guide to identify the right process, or combine them for the best result.</p>\n</div>\n<div class=\"process-shot-panel\">\n<div class=\"process-shot-inner\">\n<p class=\"process-shot-intro\">Choose the right process for your part, based on geometry, tolerance, and material.</p>\n<div class=\"process-shot-grid\">\n<div class=\"process-shot-card\">\n<div class=\"process-shot-kicker cnc\">CNC Micromachining</div>\n<h3>CNC Micromachining</h3>\n<p class=\"process-shot-subhead\">Best when you need:</p>\n<ul class=\"process-shot-list\">\n<li>Tight tolerances and structural geometry</li>\n<li>Threads, undercuts, or deep features</li>\n<li>Consistent precision across parts</li>\n</ul>\n<p class=\"process-shot-spec\"><strong>Tolerance:</strong> ~10 µm (plastics) / ~20 µm (metals)</p>\n<a class=\"process-shot-link\" href=\"https://www.potomac-laser.com/services/cnc-micro-machining-services/\">See CNC capabilities →</a>\n</div>\n<div class=\"process-shot-card\">\n<div class=\"process-shot-kicker alt\">Laser Micromachining</div>\n<h3>Laser Micromachining</h3>\n<p class=\"process-shot-subhead\">Best when you need:</p>\n<ul class=\"process-shot-list\">\n<li>Ultra-fine features or micro-holes</li>\n<li>Thin materials or delicate substrates</li>\n<li>Non-contact processing</li>\n</ul>\n<p class=\"process-shot-spec\"><strong>Feature range:</strong> 5–50 µm</p>\n<a class=\"process-shot-link\" href=\"https://www.potomac-laser.com/services/laser-micromachining/\">See laser capabilities →</a>\n</div>\n<div class=\"process-shot-card\">\n<div class=\"process-shot-kicker alt\">Conventional CNC</div>\n<h3>Conventional CNC</h3>\n<p class=\"process-shot-subhead\">Best when you need:</p>\n<ul class=\"process-shot-list\">\n<li>Larger parts (&gt;500 µm features)</li>\n<li>Simpler geometries</li>\n<li>Cost efficiency at scale</li>\n</ul>\n<p class=\"process-shot-spec\"><strong>Tolerance:</strong> ±25–50 µm typical</p>\n<a class=\"process-shot-link\" href=\"#quote\">See conventional CNC capabilities →</a>\n</div>\n</div>\n<div class=\"process-shot-footer\">\n<div class=\"max-w-[650px]\">\n<p class=\"process-shot-footer-title\">Have a part in mind? Upload Drawing / CAD and we'll recommend the best process.</p>\n<p class=\"process-shot-footer-copy\">Upload CAD (STEP, STL, IGES) or a drawing (PDF, DXF, DWG), our engineers review it for manufacturability.</p>\n<p class=\"process-shot-footer-copy\">No redesign required to start, we'll help optimise your part.</p>\n<p class=\"process-shot-footer-copy process-shot-footer-note\">Uploads stay confidential. We can sign your NDA on request before you share files.</p>\n</div>\n<div class=\"process-shot-cta-row\">\n<a class=\"process-shot-cta-primary\" href=\"#quote\">Upload Drawing / CAD</a>\n<a class=\"process-shot-cta-secondary\" href=\"#quote\">Request Material + Machining Quote</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>"
