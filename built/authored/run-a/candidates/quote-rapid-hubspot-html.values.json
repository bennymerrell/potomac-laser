"\"; position: absolute; left: 0px; top: 0px; bottom: 0px; width: 50%; background: rgb(245, 130, 31); border-radius: 999px;}\n.pl-svc-quote .gf-rapid-form-title{color: rgb(29, 53, 87); font-size: 17px; line-height: 1.35; margin: 0px 0px 22px; font-weight: 800;}\n.pl-svc-quote .gf-rapid-card form{display: grid; gap: 18px;}\n.pl-svc-quote .gf-rapid-grid{display: grid; grid-template-columns: 1fr 1fr; gap: 16px;}\n.pl-svc-quote .gf-rapid-card label{display: grid; gap: 8px;}\n.pl-svc-quote .gf-rapid-card label span{color: rgb(111, 119, 135); text-transform: uppercase; letter-spacing: 0.16em; font-size: 10px; font-weight: 800;}\n.pl-svc-quote .gf-rapid-card label span em{color: rgb(245, 130, 31); font-style: normal;}\n.pl-svc-quote .gf-rapid-card input, .pl-svc-quote .gf-rapid-card textarea{width: 100%; box-sizing: border-box; border: 1px solid rgb(221, 228, 236); border-radius: 12px; background: rgb(255, 255, 255); padding: 13px 16px; color: rgb(29, 53, 87); font-size: 14px; font-family: Inter, system-ui, sans-serif; line-height: 1.45; outline: none; transition: border-color 0.18s, box-shadow 0.18s;}\n.pl-svc-quote .gf-rapid-card input::placeholder, .pl-svc-quote .gf-rapid-card textarea::placeholder{color: rgb(161, 169, 183);}\n.pl-svc-quote .gf-rapid-card input:focus, .pl-svc-quote .gf-rapid-card textarea:focus{border-color: rgb(245, 130, 31); box-shadow: rgba(245, 130, 31, 0.12) 0px 0px 0px 3px;}\n.pl-svc-quote .gf-rapid-card textarea{min-height: 96px; resize: vertical;}\n.pl-svc-quote .gf-rapid-upload{border: 1px solid rgb(221, 228, 236); border-radius: 12px; background: rgb(251, 252, 254); padding: 12px 14px;}\n.pl-svc-quote .gf-rapid-upload input{border: 0px; padding: 0px; border-radius: 0px; background: transparent; font-size: 12px; color: rgb(105, 115, 134);}\n.pl-svc-quote .gf-rapid-upload input::file-selector-button{border: 0px; background: rgb(255, 242, 232); color: rgb(245, 130, 31); border-radius: 999px; padding: 8px 14px; margin-right: 10px; font-size: 12px;