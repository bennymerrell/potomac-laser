ct{width: 100%; box-sizing: border-box; border: 1px solid rgb(221, 228, 236); border-radius: 12px; background: linear-gradient(45deg, transparent 50%, rgb(138, 147, 163) 50%) calc(100% - 20px) calc(50% + 1px) / 6px 6px no-repeat, linear-gradient(135deg, rgb(138, 147, 163) 50%, transparent 50%) calc(100% - 14px) calc(50% + 1px) / 6px 6px rgb(255, 255, 255); padding: 13px 16px; color: rgb(29, 53, 87); font-size: 14px; font-family: Inter, system-ui, sans-serif; line-height: 1.45; outline: none; appearance: none; transition: border-color 0.18s, box-shadow 0.18s;}\n.pl-svc-quote .gf-rapid-card select:focus{border-color: rgb(245, 130, 31); box-shadow: rgba(245, 130, 31, 0.12) 0px 0px 0px 3px;}\n.pl-svc-quote .gf-rapid-note{padding: 12px 14px; background: rgb(255, 247, 240); border: 1px solid rgb(251, 224, 199); border-radius: 12px; font-size: 12px; line-height: 1.55; color: rgb(95, 104, 120);}\n.pl-svc-quote .gf-rapid-note strong{color: rgb(217, 110, 16); font-weight: 800;}\n.pl-svc-quote .gf-rapid-card form[hidden]{display: none !important;}\n.pl-svc-quote, .pl-svc-quote *, .pl-svc-quote::before, .pl-svc-quote ::before, .pl-svc-quote::after, .pl-svc-quote ::after{--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw