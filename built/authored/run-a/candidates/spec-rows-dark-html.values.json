55, 255, 255, 0.9);}\n.pl-svc-caps .text-white\\/95{color: rgba(255, 255, 255, 0.95);}\n@media (min-width: 768px){.pl-svc-caps .md\\:grid-cols-\\[220px_1fr\\]{grid-template-columns: 220px 1fr;}}\n@media (min-width: 1280px){.pl-svc-caps .xl\\:mt-6{margin-top: 1.5rem;}.pl-svc-caps .xl\\:grid-cols-\\[1\\.25fr_\\.46fr\\]{grid-template-columns: 1.25fr 0.46fr;}.pl-svc-caps .xl\\:gap-10{gap: 2.5rem;}}</style><section class=\"pl-svc-caps relative overflow-hidden py-10 px-6\" data-surface=\"dark\" id=\"capabilities\" style=\"background:linear-gradient(135deg,#182336 0%,#22334B 52%,#1D2C42 100%)\">\n<div aria-hidden=\"true\" class=\"dark-grid absolute inset-0 pointer-events-none\"></div>\n<div aria-hidden=\"true\" class=\"absolute inset-0 pointer-events-none\" style=\"background:radial-gradient(circle at 72% 18%,rgba(96,125,167,.16) 0%,transparent 28%),radial-gradient(ellipse at 50% 0%,rgba(245,130,31,.05) 0%,transparent 58%)\"></div>\n<div class=\"max-w-page mx-auto relative z-10 grid gap-8 xl:grid-cols-[1.25fr_.46fr] xl:gap-10 items-start\">\n<div>\n<div class=\"eyebrow mb-3\"><span class=\"eyebrow-text\">Technical Specifications</span></div>\n<h2 class=\"font-display font-extrabold text-white leading-tight tracking-tight mb-2\" style=\"font-size:clamp(1.9rem,3vw,2.9rem)\">CNC Micromachining Capabilities</h2>\n<p class=\"text-[15px] text-white/90 leading-relaxed mb-5\">Engineering guidance, not fixed spec promises.</p>\n<div class=\"space-y-3\">\n<div class=\"grid items-start gap-3 rounded-card border border-white/[0.05] bg-white/[0.02] px-4 py-3.5 md:grid-cols-[220px_1fr]\">\n<div class=\"text-sm font-semibold text-white/80\">Dimensional tolerance</div>\n<div class=\"text-[15px] leading-relaxed text-white/95\"><strong class=\"font-display font-extrabold text-orange text-[1.1rem]\">±10 µm</strong> achievable in plastics · <strong class=\"font-display font-extrabold text-orange text-[1.1rem]\">±20 µm</strong> typical in metals <span class=\"text-white/80\">(design dependent)</span></div>\n</div>\n<div class=\"grid items-start gap-3 rounded-card border border-white/[0.05] bg-white/[0.02] px-4 py-3.5 md:grid-cols-[220px_1fr]\">\n<div class=\"text-sm font-semibold text-white/80\">Min feature (CNC)</div>\n<div class=\"text-[15px] leading-relaxed text-white/95\"><strong class=\"font-display font-extrabold text-orange text-[1.1rem]\">100 µm</strong> features · smaller possible via hybrid CNC + laser</div>\n</div>\n<div class=\"grid items-start gap-3 rounded-card border border-white/[0.05] bg-white/[0.02] px-4 py-3.5 md:grid-cols-[220px_1fr]\">\n<div class=\"text-sm font-semibold text-white/80\">Axis capability</div>\n<div class=\"text-[15px] leading-relaxed text-white/95\"><strong class=\"font-display font-extrabold text-orange text-[1.1rem]\">4-axis</strong> machining for undercuts, compound angles, and single-setup access</div>\n</div>\n<div class=\"grid items-start gap-3 rounded-card border border-white/[0.05] bg-white/[0.02] px-4 py-3.5 md:grid-cols-[220px_1fr]\">\n<div class=\"text-sm font-semibold text-white/80\">Metals</div>\n<div class=\"text-[15px] leading-relaxed text-white/95\">SS 316L, Ti Gr23 / Gr5, aluminium, copper, nitinol</div>\n</div>\n<div class=\"grid items-start gap-3 rounded-card border border-white/[0.05] bg-white/[0.02] px-4 py-3.5 md:grid-cols-[220px_1fr]\">\n<div class=\"text-sm font-semibold text-white/80\">Polymers</div>\n<div class=\"text-[15px] leading-relaxed text-white/95\">PEEK, PMMA, COC/COP, PTFE, PC, Kapton</div>\n</div>\n<div class=\"grid items-start gap-3 rounded-card border border-white/[0.05] bg-white/[0.02] px-4 py-3.5 md:grid-cols-[220px_1fr]\">\n<div class=\"text-sm font-semibold text-white/80\">Min order quantity</div>\n<div class=\"text-[15px] leading-relaxed text-white/95\"><strong class=\"font-display font-extrabold text-orange text-[1.1rem]\">No MOQ</strong>, from early prototype through production transfer</div>\n</div>\n<div class=\"grid items-start gap-3 rounded-card border border-white/[0.05] bg-white/[0.02] px-4 py-3.5 md:grid-cols-[220px_1fr]\">\n<div class=\"text-sm font-semibold text-white/80\">Team response</div>\n<div class=\"text-[15px] leading-relaxed text-white/95\"><strong class=\"font-display font-extrabold text-orange text-[1.1rem]\">24 h</strong> rapid response to new drawings, specifications, and quote requests</div>\n</div>\n<div class=\"grid items-start gap-3 rounded-card border border-white/[0.05] bg-white/[0.02] px-4 py-3.5 md:grid-cols-[220px_1fr]\">\n<div class=\"text-sm font-semibold text-white/80\">Inspection</div>\n<div class=\"text-[15px] leading-relaxed text-white/95\">Optical metrology, CMM, first-article review, and wider lab support where required</div>\n</div>\n</div>\n<p class=\"mt-5 text-sm leading-relaxed text-white/90\">Material selection supported, customers often work with engineering to optimise for manufacturability.</p>\n</div>\n<div class=\"rounded-card border border-white/[0.08] bg-white/[0.04] p-5 xl:mt-6\">\n<div class=\"text-[11px] font-bold tracking-[.18em] text-orange uppercase mb-3\">Material Support</div>\n<h3 class=\"font-display font-extrabold text-white text-[1.35rem] leading-tight mb-3\">Material support available</h3>\n<p class=\"text-[15px] leading-relaxed text-white/95\">Work with your own material or select from <strong class=\"font-extrabold text-orange\">170,000+</strong> options.</p>\n<p class=\"mt-4 text-sm leading-relaxed text-white/80\">Broader material matching and traceability support are available through the wider Goodfellow library.</p>\n</div>\n</div>\n</section>"
