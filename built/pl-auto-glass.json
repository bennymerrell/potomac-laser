        "id": "e43a05d",
        "elType": "widget",
        "widgetType": "text-editor",
        "settings": {
         "editor": "<ul class=\"cards p26\"><li><span class=\"meta\">Marking</span><h3>Laser engraving</h3><p>Detailed, permanent markings for branding and identification.</p></li><li><span class=\"meta\">Marking</span><h3>Inkjet printing</h3><p>High-resolution markings for product information and appearance.</p></li><li><span class=\"meta\">Marking</span><h3>Etching</h3><p>Subtle designs that improve the appearance of glass products.</p></li><li><span class=\"meta\">Drilling</span><h3>Automated hole drilling</h3><p>Automated drilling equipment that improves efficiency and reduces turnaround times.</p></li><li><span class=\"meta\">Drilling</span><h3>Precision drilling</h3><p>Small to large diameter holes, drilled accurately and consistently.</p></li><li><span class=\"meta\">Drilling</span><h3>Custom drilling</h3><p>Drilling processes developed to your project requirements.</p></li></ul>",
         "typography_typography": "custom",
         "typography_font_family": "Inter",
         "typography_font_size": {
          "unit": "px",
          "size": 16
         },
         "typography_font_weight": "400",
