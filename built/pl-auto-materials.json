       {
        "id": "b86e595",
        "elType": "widget",
        "widgetType": "text-editor",
        "settings": {
         "editor": "<ul class=\"cards\"><li><a href=\"https://www.potomac-laser.com/?page_id=12392&preview=true\"><span class=\"meta\">Goodfellow Microfabrication</span><h3>Metal Parts</h3><p>Precise features in almost any metal, as small as 1 micron.</p><span class=\"more\">View material</span></a></li><li><a href=\"https://www.potomac-laser.com/?page_id=12393&preview=true\"><span class=\"meta\">Goodfellow Microfabrication</span><h3>Plastic Micromachining</h3><p>Almost any polymer, from single prototypes to production runs.</p><span class=\"more\">View material</span></a></li><li><a href=\"https://www.potomac-laser.com/?page_id=12389&preview=true\"><span class=\"meta\">Goodfellow Microfabrication</span><h3>Pressure-Sensitive Adhesives</h3><p>Cutting and patterning of adhesive layers.</p><span class=\"more\">View material</span></a></li><li><a href=\"https://www.potomac-laser.com/?page_id=12396&preview=true\"><span class=\"meta\">Goodfellow Microfabrication</span><h3>Thin Metal Foils</h3><p>Laser machining of thin metal foils.</p><span class=\"more\">View material</span></a></li><li><a href=\"https://www.potomac-laser.com/?page_id=12391&preview=true\"><span class=\"meta\">Goodfellow Microfabrication</span><h3>Kapton, Polyimide</h3><p>Kapton HN and VN held on the shelf.</p><span class=\"more\">View material</span></a></li><li><a href=\"https://www.potomac-laser.com/material/ceramics/\"><span class=\"meta\">Goodfellow Microfabrication</span><h3>Ceramics and PZT</h3><p>Laser cutting of ceramic and PZT.</p><span class=\"more\">View material</span></a></li><li><a href=\"https://www.potomac-laser.com/material/microfluidics-polymers-vs-glass/\"><span class=\"meta\">Goodfellow Microfabrication</span><h3>Microfluidics: polymers vs. glass</h3><p>Choosing a substrate for microfluidic devices.</p><span class=\"more\">View material</span></a></li><li><a href=\"https://www.potomac-laser.com/material/silicon-2/\"><span class=\"meta\">Goodfellow Microfabrication</span><h3>Silicon wafers</h3><p>Laser micromachining of silicon wafers.</p><span class=\"more\">View material</span></a></li><li><a href=\"https://www.potomac-laser.com/?page_id=12390&preview=true\"><span class=\"meta\">Goodfellow Microfabrication</span><h3>Glass</h3><p>Micromachining of glass substrates.</p><span class=\"more\">View material</span></a></li></ul>",
         "typography_typography": "custom",
