e=sealed]) .qs-ok{display:grid;place-items:center}\n.pl-svc-quote :is([data-state=done],[data-state=sealed]) .qs-n{display:none}\n.pl-svc-quote .qs-guide{transition:opacity .3s,border-color .3s,box-shadow .3s}\n.pl-svc-quote .qs-guide[data-state=locked]{opacity:.55}\n.pl-svc-quote .qs-guide[data-state=locked] .gf-rapid-num{background:#C5CCD6;box-shadow:none}\n.pl-svc-quote .qs-guide[data-state=active]{border-color:#F5821F;box-shadow:0 10px 24px rgba(15,42,68,.08)}\n.pl-svc-quote .qs-guide[data-state=done] .gf-rapid-num{background:#16A34A;color:#fff;border:0;box-shadow:0 10px 20px rgba(22,163,74,.2)}\n.pl-svc-quote .qs-guide[data-state=done] .gf-rapid-label{color:#15803D}\n.pl-svc-quote .qs-done{border-color:#16A34A;background:#F0FDF4;box-shadow:0 10px 24px rgba(22,163,74,.12);animation:qsIn .45s cubic-bezier(.25,.46,.45,.94) both}\n.pl-svc-quote .qs-done__num{background:#16A34A !important;box-shadow:0 10px 20px rgba(22,163,74,.2) !important}\n.pl-svc-quote .qs-done__label{color:#15803D !important}\n.pl-svc-quote .qs-done p strong{color:#1D3557;font-weight:700}\n@keyframes qsIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}\n@media (prefers-reduced-motion:reduce){.pl-svc-quote .qs-done{animation:none}\n.pl-svc-quote .qs-body,.pl-svc-quote .qs-block,.pl-svc-quote .qs-guide{transition:none}}\n.pl-svc-quote{font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important; color: rgb(34, 57, 93);}\n.pl-svc-quote h2, .pl-svc-quote h3, .pl-svc-quote .gf-rapid-left h2{letter-spacing: -0.03em; color: rgb(34, 57, 93); font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important; font-weight: 800 !important;}\n.pl-svc-quote p, .pl-svc-quote span, .pl-svc-quote button, .pl-svc-quote input, .pl-svc-quote textarea, .pl-svc-quote select{font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important;}\n.pl-svc-quote, .pl-svc-quote *, .pl-svc-quote::after, .pl-svc-quote ::aft